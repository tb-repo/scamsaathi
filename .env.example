# Copy to .env and fill in. NEVER commit .env.

# --- Gemini (primary provider, paid tier) ---
GEMINI_API_KEY=your-key-here
# Optional overrides. Defaults live in config/llm.yaml (verified 2026-11-11, ADR-008):
#   fast = gemini-3.5-flash-lite, reasoning = gemini-3.8-flash
# Leave as TBD to use the config defaults.
GEMINI_MODEL_FAST=TBD
GEMINI_MODEL_REASONING=TBD
# Embedding model is chosen in ADR-004 (candidates: gemini-embedding-2, gemini-embedding-001).
GEMINI_EMBEDDING_MODEL=TBD

# --- Optional fallback providers ---
GROQ_API_KEY=
GROQ_MODEL_FAST=TBD

# --- App behaviour ---
SCAMSAATHI_MODE=live            # live | cached | offline
SCAMSAATHI_LLM_CACHE_DIR=.cache/llm
SCAMSAATHI_MAX_LLM_CALLS_PER_REQUEST=6   # safeguard against loops, not a cost target (ADR-001)
SCAMSAATHI_DAILY_CALL_BUDGET=500
SCAMSAATHI_LOG_LEVEL=INFO
